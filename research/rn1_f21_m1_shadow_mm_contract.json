    "full_depth_exact_level_required_for_queue_initialization": true
  },
  "failure_semantics": {
    "collector_gap": "Invalidate the shadow order from the gap onward; do not invent fills through missing data.",
    "missing_trade_side": "Reject event.",
    "missing_trade_size": "Reject event.",
