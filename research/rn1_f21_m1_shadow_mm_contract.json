  },
  "trade_semantics": {
    "resting_bid_consumed_by": "SELL aggressor at the resting bid price.",
    "resting_ask_consumed_by": "BUY aggressor at the resting ask price.",
    "trade_quantity_first_consumes_queue_ahead": true,
    "remaining_trade_quantity_can_fill_our_order": true,
    "partial_fills_allowed": true,
    "trade_at_unrelated_price": "No queue or fill effect.",
    "trade_side_required": true,
    "trade_size_required": true
  },
  "cancel_semantics": {
    "cancel_request_does_not_immediately_remove_order": true,
    "cancel_effective_time": "cancel_request_time + configured cancel_latency_ms",
    "trades_before_cancel_effective_time_can_fill": true,
    "trade_exactly_at_cancel_effective_time_can_fill": true,
    "cancel_becomes_effective_before_any_event_strictly_after_cancel_effective_time": true,
    "repeated_cancel_request": "Idempotent; first request wins."
  },
  "placement_semantics": {
    "placement_effective_time": "submit_time + configured placement_latency_ms",
    "order_cannot_fill_before_placement_effective_time": true,
