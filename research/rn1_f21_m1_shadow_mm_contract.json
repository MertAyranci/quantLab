  "queue_semantics": {
    "fifo_assumption": true,
    "initial_queue_ahead": "Displayed public size already resting at the exact quote price when our passive order becomes effective.",
    "join_position": "Behind all displayed size already at the exact price.",
    "book_size_increase_after_join": "Does not increase queue ahead; new displayed liquidity is assumed to join behind our order.",
