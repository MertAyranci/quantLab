  "h6_m1_engineering_policy": {
    "m1_market_ids_must_be_added_to_h6_burned_set_before_m2": true,
    "m1_market_ids_must_be_frozen_before_capture": true,
    "may_overlap_f19_condition_ids": true,
    "may_overlap_future_h5_condition_ids_if_not_yet_registered": true,
    "may_read_f19_trade_content": false,
    "may_read_f20": false,
