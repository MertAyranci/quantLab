{
  "study": "RN1-F19b",
  "status": "PROSPECTIVE_RAW_ACQUISITION",
  "parent": "RN1-F19a",
  "purpose": "Acquire raw public Polymarket trade data for prospectively registered OOS MLB moneyline markets without evaluating the frozen signal or economic performance.",
  "eligibility_gate": {
    "must_exist_in_f19_registry": true,
    "minimum_hours_after_registered_game_start": 12,
    "gamma_closed_must_equal": true,
    "selection_order": [
      "game_start_time_utc",
      "condition_id"
    ],
    "performance_based_selection": false
  },
  "streams": {
    "market_taker": {
      "api": "https://data-api.polymarket.com/trades",
      "market_filter": "registered condition_id",
      "takerOnly": true,
      "purpose": "Full public market taker tape."
    },
    "rn1_all": {
      "api": "https://data-api.polymarket.com/trades",
      "user": "RN1 from config/research_wallets.json",
      "market_filter": "registered condition_id",
      "takerOnly": false,
      "purpose": "RN1 maker-and-taker trade stream."
    }
  },
  "pagination": {
    "limit": 500,
    "maximum_offset": 10000,
    "complete_only_when_final_page_is_shorter_than_limit": true,
    "fail_if_api_feed_reaches_offset_boundary_without_exhaustion": true
  },
  "stability_check": {
    "independent_fetch_passes": 2,
    "compare": [
      "row_count",
      "canonical_core_trade_sha256"
    ],
    "require_exact_match": true
  },
  "canonical_core_trade_fields": [
    "proxyWallet",
    "side",
    "asset",
    "conditionId",
    "size",
    "price",
    "timestamp",
    "transactionHash",
    "outcome",
    "outcomeIndex"
  ],
  "raw_root": "data/prospective/rn1_f19/acquisition",
  "finalization": {
    "atomic_per_market_directory": true,
    "existing_finalized_market_is_never_overwritten": true,
    "partial_failed_acquisition_is_not_finalized": true
  },
  "analysis_boundary": {
    "calculate_flow_signal": false,
    "classify_flagged_opportunities": false,
    "calculate_markout": false,
    "use_outcome_or_winner": false,
    "use_settlement": false,
    "calculate_pnl": false,
    "optimize_parameters": false,
    "early_performance_stopping": false
  }
}
